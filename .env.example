# ==========================================
# Diabetes RAG - Environment Variables
# ==========================================

# 1. Google Gemini API (Required for Layer 3 Grounded Generation)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Telegram Bot Configuration (Required for the Telegram Bot Worker)
# Obtain token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 3. Vector Database (Qdrant) Configuration
# In docker-compose, this is 'qdrant'. For Railway private networking, use your internal Qdrant host.
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# 4. API URL for Bot Worker
# In docker-compose: http://api:8000/ask. For single-container / local: http://127.0.0.1:8000/ask
API_URL=http://api:8000/ask

# 5. Server Port (automatically set by Railway, default: 8000)
PORT=8000

# 6. Combined Mode Flag (Optional - set to true to run bot alongside API in a single container)
# START_BOT=false
